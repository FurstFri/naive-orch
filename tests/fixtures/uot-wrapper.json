{
  "log": { "level": "warn" },
  "inbounds": [
    { "type": "mixed", "tag": "in", "listen": "127.0.0.1", "listen_port": 1100 }
  ],
  "outbounds": [
    { "type": "socks", "tag": "naive", "server": "127.0.0.1", "server_port": 2100 },
    {
      "type": "socks",
      "tag": "uot",
      "server": "proxy.example.com",
      "server_port": 8389,
      "udp_over_tcp": { "enabled": true, "version": 2 },
      "detour": "naive"
    }
  ],
  "route": {
    "rules": [ { "network": "udp", "action": "route", "outbound": "uot" } ],
    "final": "naive"
  }
}
